{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "listen",
	"account_id": "3440ce4434b656cf94f6a5cf70470afd",
	"main": "src/index.js",
	"compatibility_date": "2026-10-03",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": false
	},
	"d1_databases": [
