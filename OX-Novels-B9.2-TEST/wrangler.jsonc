{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "ox-novels",
    "main": "src/index.js",
    "compatibility_date": "2026-08-08",

    "workers_dev": false,
    "preview_urls": false,

    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": [
            "/api/*"
        ]
    },

    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "ox-novels-db",
            "database_id": "4616c768-dd75-491e-ac56-0c394577dcd7",
            "migrations_dir": "migrations"
        }
    ]
}